# Database connection string (Supabase or Neon)
DATABASE_URL="postgresql://user:password@host:5432/focusos?schema=public"

# Your app's public URL (for extension to call)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API key for extension authentication (prototype auth)
# Generate with: openssl rand -hex 32
FOCUS_OS_API_KEY="your-secure-api-key-here"

# Demo user email (for prototype)
DEMO_USER_EMAIL="demo@focusos.local"
